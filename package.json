{
  "name": "risk-radar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm -w risk-radar-api run dev",
    "dev:worker": "npm -w riskradar-worker run dev",
    "db:generate": "npm -w @risk-radar/db run db:generate",
    "db:migrate": "npm -w @risk-radar/db run db:migrate",
    "dev": "concurrently -n api,worker \"npm run dev:api\" \"npm run dev:worker\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
