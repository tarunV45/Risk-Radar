generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Repo {
  id        String   @id @default(cuid())
  name      String
  localPath String
  createdAt DateTime @default(now())
  scans     Scan[]
}

model Scan {
  id         String           @id @default(cuid())
  repoId     String
  repo       Repo             @relation(fields: [repoId], references: [id], onDelete: Cascade)
  status     ScanStatus       @default(QUEUED)
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime         @default(now())
  deps       ScanDependency[]
}

model Package {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  deps      ScanDependency[]
}

model ScanDependency {
  id        String  @id @default(cuid())
  scanId    String
  scan      Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  packageId String
  pkg       Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  requestedRange  String?
  resolvedVersion String
  latestVersion   String
  riskScore       Int
  flags           Json

  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([packageId])
}
